  view_file {
    absolute_path_uri: "file:///src/test/aiInsights.test.ts"
    end_line: 64
    content: "import { describe, it, expect, beforeEach, afterEach } from \'vitest\';\nimport express from \'express\';\nimport request from \'supertest\';\nimport { apiRouter } from \'../api/routes.ts\';\n\nconst app = express();\napp.use(express.json());\napp.use(\'/api/v1\', apiRouter);\n\ndescribe(\'AI Insights Endpoint Fallback\', () => {\n  const origKey = process.env.GEMINI_API_KEY;\n\n  beforeEach(() => {\n    delete process.env.GEMINI_API_KEY;\n  });\n\n  afterEach(() => {\n    if (origKey !== undefined) {\n      process.env.GEMINI_API_KEY = origKey;\n    } else {\n      delete process.env.GEMINI_API_KEY;\n    }\n  });\n\n  it(\'returns safe rule-based insights when GEMINI_API_KEY is missing\', async () => {\n    const res = await request(app)\n      .post(\'/api/v1/forecast/ai-insights\')\n      .send({\n        date: \'2029-11-20\',\n        meal: \'lunch\',\n        predictedDiners: 450,\n        baselineDiners: 440,\n        context: \'normal\',\n        items: [{ name: \'Rice\', suggestedPrep: 300 }]\n      });\n\n    expect(res.status).toBe(200);\n    expect(res.body.available).toBe(false);\n    expect(res.body.insights).toBeDefined();\n    expect(Array.isArray(res.body.insights)).toBe(true);\n    expect(res.body.insights.length).toBeGreaterThan(0);\n  });\n\n  it(\'returns safe rule-based insights when GEMINI_API_KEY is invalid\', async () => {\n    process.env.GEMINI_API_KEY = \'invalid-key-for-testing\';\n\n    const res = await request(app)\n      .post(\'/api/v1/forecast/ai-insights\')\n      .send({\n        date: \'2029-11-20\',\n        meal: \'lunch\',\n        predictedDiners: 450,\n        baselineDiners: 440,\n        context: \'normal\',\n        items: [{ name: \'Rice\', suggestedPrep: 300 }]\n      });\n\n    expect(res.status).toBe(200);\n    expect(res.body.available).toBe(false);\n    expect(res.body.insights).toBeDefined();\n    expect(Array.isArray(res.body.insights)).toBe(true);\n    expect(res.body.insights.length).toBeGreaterThan(0);\n  });\n});\n"
    num_lines: 65
    num_bytes: 1903
    line_range_bytes: 1903
  }
}
