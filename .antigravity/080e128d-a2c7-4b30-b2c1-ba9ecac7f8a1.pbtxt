    content: "/**\n * SYNTHETIC DEMONSTRATION DATA.\n * Everything here is generated by deterministic formulas (no Math.random) so the demo is reproducible.\n * It does not represent any real institution, kitchen or measured outcome.\n */\nimport type { MealRecord, MealType, Menu, RecordItem, Settings } from \'../types\';\nimport { DEMO_TODAY, MEAL_ORDER } from \'../lib/constants\';\nimport { addDays, dayOfWeek, diffDays } from \'../lib/dates\';\nimport { ceilToStep, computeForecast } from \'../services/mockForecastService\';\nimport { recordFromForecast, recordId } from \'../services/operationsService\';\nimport { trailingBaseline } from \'../services/baseline\';\n\nexport interface FoodCatalogEntry {\n  name: string;\n  kgPerPortion: number;\n  /** Synthetic \"truth\": share of diners who take the item. */\n  uptake: number;\n  /** Synthetic effect on attendance when the dish is on the menu. */\n  pull: number;\n  /** Synthetic tendency of managers to prepare extra of this item. */\n  overprep: number;\n}\n\nconst f = (name: string, kgPerPortion: number, uptake: number, pull = 0, overprep = 0): FoodCatalogEntry => ({\n  name,\n  kgPerPortion,\n  uptake,\n  pull,\n  overprep,\n});\n\nexport const FOOD_CATALOG: FoodCatalogEntry[] = [\n  f(\'Idli\', 0.1, 0.72),\n  f(\'Pongal\', 0.25, 0.45),\n  f(\'Medu Vada\', 0.08, 0.5, 0.02),\n  f(\'Dosa\', 0.12, 0.6, 0.03),\n  f(\'Upma\', 0.2, 0.35, -0.02),\n  f(\'Poori\', 0.15, 0.55, 0.04),\n  f(\'Potato Masala\', 0.15, 0.5),\n  f(\'Sambar\', 0.15, 0.75),"
    num_lines: 265
    num_bytes: 9739
    line_range_bytes: 1433
  }
}
