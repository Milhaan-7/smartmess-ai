    content: "export type MealType = \'breakfast\' | \'lunch\' | \'dinner\';\n/** Lifecycle of a saved kitchen plan. `not_planned` is display-only (no record exists). */\nexport type PlanStatus = \'recommended\' | \'approved\' | \'completed\';\nexport type DisplayStatus = PlanStatus | \'not_planned\';\nexport type SpecialDay = \'normal\' | \'exam_week\' | \'campus_event\' | \'festival_holiday\';\nexport type PageId = \'dashboard\' | \'forecasts\' | \'menus\' | \'operations\' | \'waste\' | \'settings\' | \'login\';\n\n\nexport interface MenuItem {\n  id: string;\n  name: string;\n  /** Weight of one portion in kilograms (beverages: 1 L \342\211\210 1 kg). */\n  kgPerPortion: number;\n}\n\nexport interface Menu {\n  id: string;\n  /** ISO calendar date, YYYY-MM-DD */\n  date: string;\n  meal: MealType;\n  items: MenuItem[];\n}\n\nexport interface Settings {\n  institutionName: string;\n  messName: string;\n  location: string;\n  messManager: string;\n  /** Extra % added on top of predicted demand when suggesting preparation. */\n  prepBufferPct: number;\n  /** Maximum diners the mess can serve per meal. */\n  serviceCapacity: number;\n  /** Suggested quantities are rounded up to a multiple of this many portions. */\n  roundingStep: number;\n  /** Share of diners assumed to take an item that has no history (0\342\200\2231). */\n  defaultUptake: number;\n  defaultReviewMeal: MealType;\n  upcomingHorizonDays: number;\n}\n\n/* ---------- Forecasting ---------- */\n\nexport interface ForecastInput {\n  date: string;\n  meal: MealType;\n  menu: Menu;\n  /** Saved meal records used as history (only completed records with actual diners are used). */\n  history: MealRecord[];\n  settings: Settings;\n  context: SpecialDay;\n}\n\nexport interface ForecastFactor {\n  id: string;\n  label: string;\n  description: string;\n  multiplier: number;\n  /** Change in expected diners attributable to this factor (rounded; impacts sum to forecast \342\210\222 baseline). */\n  impactDiners: number;\n}\n\nexport interface ItemForecast {\n  itemId: string;\n  name: string;\n  kgPerPortion: number;\n  uptake: number;\n  uptakeSource: \'history\' | \'default\';\n  predictedDemand: number;\n  lowerDemand: number;\n  upperDemand: number;\n  baselineDemand: number;\n  suggestedPrep: number;\n}\n\nexport interface Forecast {\n  date: string;\n  meal: MealType;\n  context: SpecialDay;\n  predictedDiners: number;\n  lowerDiners: number;\n  upperDiners: number;\n  baselineDiners: number;\n  historyRecordsUsed: number;\n  factors: ForecastFactor[];\n  items: ItemForecast[];\n  assumptions: {\n    prepBufferPct: number;\n    roundingStep: number;\n    serviceCapacity: number;\n    bandDiners: number;\n  };\n  method: string;\n}\n\n/* ---------- Kitchen operations ---------- */\n\nexport interface RecordItem {\n  itemId: string;\n  name: string;\n  kgPerPortion: number;\n  predictedDemand: number;\n  lowerDemand: number;\n  upperDemand: number;\n  suggestedPrep: number;\n  /** Set only when the kitchen manager confirms the plan. */\n  approvedPrep: number | null;\n  prepared: number | null;\n  consumed: number | null;\n}\n\nexport interface MealRecord {\n  id: string;\n  date: string;\n  meal: MealType;\n  status: PlanStatus;\n  context: SpecialDay;\n  predictedDiners: number;\n  lowerDiners: number;\n  upperDiners: number;\n  /** Trailing-mean baseline as of forecast time (see services/baseline.ts); null when there was not enough history. */\n  baselineDiners: number | null;\n  /** Where the stored forecast came from: generated demo values, or the rule-based forecaster. */\n  forecastSource: \'synthetic_seed\' | \'rule_based\';\n  actualDiners: number | null;\n  approvedAt: string | null;\n  completedAt: string | null;\n  items: RecordItem[];\n}\n\n/* ---------- Notifications ---------- */\n\nexport interface AppNotification {\n  id: string;\n  title: string;\n  message: string;\n  type: \'daily\' | \'weekly\';\n  date: string;\n  meal?: MealType;\n  timestamp: string;\n  read: boolean;\n  linkHash: string;\n}\n\n"
    num_lines: 144
    num_bytes: 3818
    line_range_bytes: 3818
  }
}
