  view_file {
    absolute_path_uri: "file:///src/data/mockData.ts"
    start_line: 99
    end_line: 264
    content: "\nconst BASE_DINERS: Record<MealType, number> = { breakfast: 430, lunch: 560, dinner: 530 };\nconst DOW_TRUTH: Record<MealType, number[]> = {\n  breakfast: [0.86, 1.03, 1.03, 1.02, 1.01, 0.99, 0.92],\n  lunch: [0.96, 1.03, 1.03, 1.02, 1.0, 0.95, 0.88],\n  dinner: [0.97, 1.04, 1.04, 1.02, 0.98, 0.9, 0.86],\n};\n\n/** Deterministic pseudo-noise in [\342\210\2221, 1) from a string key (FNV-1a hash). Not random. */\nexport function syntheticNoise(key: string): number {\n  let h = 0x811c9dc5;\n  for (let i = 0; i < key.length; i++) {\n    h ^= key.charCodeAt(i);\n    h = Math.imul(h, 0x01000193) >>> 0;\n  }\n  return (h / 0xffffffff) * 2 - 1;\n}\n\nexport const DEFAULT_SETTINGS: Settings = {\n  institutionName: \'Greenfield University\',\n  messName: \'North Hostel Mess (Block B)\',\n  location: \'Greenfield, Demo State (fictional)\',\n  messManager: \'Meera Krishnan\',\n  prepBufferPct: 8,\n  serviceCapacity: 620,\n  roundingStep: 5,\n  defaultUptake: 0.7,\n  defaultReviewMeal: \'lunch\',\n  upcomingHorizonDays: 3,\n};\n\nfunction menuFor(date: string, meal: MealType): Menu {\n  const id = `menu-${date}-${meal}`;\n  const names = WEEKLY_MENUS[meal][dayOfWeek(date)];\n  return {\n    id,\n    date,\n    meal,\n    items: names.map((name, idx) => ({ id: `${id}-${idx}`, name, kgPerPortion: catalog.get(name)?.kgPerPortion ?? 0.2 })),\n  };\n}\n\nfunction actualDinersFor(menu: Menu): number {\n  const pull = menu.items.reduce((s, i) => s + (catalog.get(i.name)?.pull ?? 0), 0);\n  const drift = 1 + 0.002 * diffDays(menu.date, DEMO_TODAY);\n  const noise = syntheticNoise(`actual|${menu.date}|${menu.meal}`) * 0.035;\n  return Math.round(BASE_DINERS[menu.meal] * DOW_TRUTH[menu.meal][dayOfWeek(menu.date)] * (1 + pull) * drift * (1 + noise));\n}\n\nfunction historicalRecord(menu: Menu): MealRecord {\n  const actual = actualDinersFor(menu);\n  const predicted = Math.round(actual * (1 + 0.09 * syntheticNoise(`pred|${menu.date}|${menu.meal}`) - 0.005));\n  const band = Math.max(10, Math.round(predicted * 0.06));\n  const items: RecordItem[] = menu.items.map((mi) => {\n    const c = catalog.get(mi.name);\n    const uptake = c?.uptake ?? 0.7;\n    const key = `${menu.date}|${menu.meal}|${mi.name}`;\n    const predictedDemand = Math.round(predicted * uptake);\n    const suggestedPrep = ceilToStep(predictedDemand * 1.08, 5);\n    const approvedPrep = ceilToStep(suggestedPrep * (1 + (c?.overprep ?? 0)), 5);\n    const prepared = Math.max(0, approvedPrep + Math.round(syntheticNoise(`prep|${key}`) * 2));\n    const trueDemand = Math.round(actual * uptake * (1 + 0.1 * syntheticNoise(`dem|${key}`)));\n    const consumed = Math.min(prepared, trueDemand);\n    return {\n      itemId: mi.id,\n      name: mi.name,\n      kgPerPortion: mi.kgPerPortion,\n      predictedDemand,\n      lowerDemand: Math.round((predicted - band) * uptake),\n      upperDemand: Math.round((predicted + band) * uptake),\n      suggestedPrep,\n      approvedPrep,\n      prepared,\n      consumed,\n    };\n  });\n  return {\n    id: recordId(menu.date, menu.meal),\n    date: menu.date,\n    meal: menu.meal,\n    status: \'completed\',\n    context: \'normal\',\n    predictedDiners: predicted,\n    lowerDiners: predicted - band,\n    upperDiners: predicted + band,\n    baselineDiners: null, // assigned in createSeedState from the shared trailing-mean definition\n    forecastSource: \'synthetic_seed\',\n    actualDiners: actual,\n    approvedAt: `${menu.date}T06:30:00`,\n    completedAt: `${menu.date}T15:00:00`,\n    items,\n  };\n}\n\nexport interface SeedState {\n  menus: Menu[];\n  records: MealRecord[];\n  settings: Settings;\n  notifications: import(\'../types\').AppNotification[];\n}\n\nexport function createSeedState(): SeedState {\n  const settings = { ...DEFAULT_SETTINGS };\n  const menus: Menu[] = [];\n  // 28 days of history: the first 14 are warm-up so every meal in the 14-day evaluation window has a baseline.\n  for (let offset = -28; offset <= 7; offset++) {\n    for (const meal of MEAL_ORDER) menus.push(menuFor(addDays(DEMO_TODAY, offset), meal));\n  }\n\n  const seeded: MealRecord[] = [];\n  for (let offset = -28; offset <= -1; offset++) {\n    for (const meal of MEAL_ORDER) seeded.push(historicalRecord(menuFor(addDays(DEMO_TODAY, offset), meal)));\n  }\n  // Today: breakfast already served; lunch approved but results not yet entered; dinner awaiting review.\n  seeded.push(historicalRecord(menuFor(DEMO_TODAY, \'breakfast\')));\n\n  // Stored baselines use the same definition as the forecaster (services/baseline.ts).\n  const records: MealRecord[] = seeded.map((r) => {\n    const b = trailingBaseline(seeded, r.meal, r.date);\n    return { ...r, baselineDiners: b ? Math.round(b.exact) : null };\n  });\n\n  const history = [...records];\n  for (const meal of [\'lunch\', \'dinner\'] as const) {\n    const menu = menuFor(DEMO_TODAY, meal);\n    const rec = recordFromForecast(computeForecast({ date: DEMO_TODAY, meal, menu, history, settings, context: \'normal\' }));\n    if (meal === \'lunch\') {\n      records.push({\n        ...rec,\n        status: \'approved\',\n        approvedAt: `${DEMO_TODAY}T08:40:00`,\n        items: rec.items.map((i) => ({ ...i, approvedPrep: i.suggestedPrep })),\n      });\n    } else {\n      records.push(rec);\n    }\n  }\n\n  const notifications: import(\'../types\').AppNotification[] = [\n    {\n      id: \'notif-today-lunch\',\n      title: \"Today\'s Lunch Menu Approved\",\n      message: \"The manager has approved the Lunch menu for today. View portion weights and service hours.\",\n      type: \'daily\',\n      date: DEMO_TODAY,\n      meal: \'lunch\',\n      timestamp: `${DEMO_TODAY}T08:40:00`,\n      read: false,\n      linkHash: `#/menus?date=${DEMO_TODAY}`,\n    },\n    {\n      id: \'notif-weekly-published\',\n      title: \"Weekly Dining Menu Available\",\n      message: \"The published dining menu for this week is now available for students.\",\n      type: \'weekly\',\n      date: DEMO_TODAY,\n      timestamp: `${DEMO_TODAY}T08:00:00`,\n      read: true,\n      linkHash: \'#/menus\',\n    },\n  ];\n\n  return { menus, records, settings, notifications };\n}\n\n"
    num_lines: 265
    num_bytes: 9739
    line_range_bytes: 5943
  }
}
