    content: "/**\n * SYNTHETIC DEMONSTRATION DATA.\n * Everything here is generated by deterministic formulas (no Math.random) so the demo is reproducible.\n * It does not represent any real institution, kitchen or measured outcome.\n */\nimport type { MealRecord, MealType, Menu, RecordItem, Settings } from \'../types\';\nimport { DEMO_TODAY, MEAL_ORDER } from \'../lib/constants\';\nimport { addDays, dayOfWeek, diffDays } from \'../lib/dates\';\nimport { ceilToStep, computeForecast } from \'../services/mockForecastService\';\nimport { recordFromForecast, recordId } from \'../services/operationsService\';\nimport { trailingBaseline } from \'../services/baseline\';\n\nexport interface FoodCatalogEntry {\n  name: string;\n  kgPerPortion: number;\n  /** Synthetic \"truth\": share of diners who take the item. */\n  uptake: number;\n  /** Synthetic effect on attendance when the dish is on the menu. */\n  pull: number;\n  /** Synthetic tendency of managers to prepare extra of this item. */\n  overprep: number;\n}\n\nconst f = (name: string, kgPerPortion: number, uptake: number, pull = 0, overprep = 0): FoodCatalogEntry => ({\n  name,\n  kgPerPortion,\n  uptake,\n  pull,\n  overprep,\n});\n\nexport const FOOD_CATALOG: FoodCatalogEntry[] = [\n  f(\'Idli\', 0.1, 0.72),\n  f(\'Pongal\', 0.25, 0.45),\n  f(\'Medu Vada\', 0.08, 0.5, 0.02),\n  f(\'Dosa\', 0.12, 0.6, 0.03),\n  f(\'Upma\', 0.2, 0.35, -0.02),\n  f(\'Poori\', 0.15, 0.55, 0.04),\n  f(\'Potato Masala\', 0.15, 0.5),\n  f(\'Sambar\', 0.15, 0.75),\n  f(\'Coconut Chutney\', 0.05, 0.8),\n  f(\'Boiled Egg\', 0.06, 0.4, 0, 0.1),\n  f(\'Banana\', 0.12, 0.45, 0, 0.05),\n  f(\'Tea/Coffee\', 0.2, 0.85),\n  f(\'Steamed Rice\', 0.3, 0.9, 0, 0.1),\n  f(\'Rasam\', 0.15, 0.6),\n  f(\'Vegetable Curry\', 0.12, 0.8),\n  f(\'Chicken Curry\', 0.15, 0.5, 0.03),\n  f(\'Dal Fry\', 0.15, 0.7),\n  f(\'Curd\', 0.1, 0.65),\n  f(\'Papad\', 0.01, 0.6),\n  f(\'Payasam\', 0.1, 0.55, 0.01, 0.12),\n  f(\'Chapati\', 0.08, 0.7, 0, 0.08),\n  f(\'Veg Biryani\', 0.4, 0.55, 0.05),\n  f(\'Chicken Biryani\', 0.4, 0.6, 0.08),\n  f(\'Raita\', 0.1, 0.5),\n  f(\'Dal Tadka\', 0.15, 0.65),\n  f(\'Paneer Butter Masala\', 0.15, 0.55, 0.03),\n  f(\'Curd Rice\', 0.25, 0.35, 0, 0.15),\n  f(\'Parotta\', 0.12, 0.55, 0.06),\n  f(\'Kurma\', 0.15, 0.6),\n  f(\'Egg Curry\', 0.15, 0.35),\n  f(\'Fried Rice\', 0.3, 0.45, 0.02),\n  f(\'Veg Manchurian\', 0.12, 0.45, 0.01),\n  f(\'Lemon Rice\', 0.25, 0.4),\n];\n\nconst catalog = new Map(FOOD_CATALOG.map((c) => [c.name, c]));\n\n/** Weekly rotation, indexed Sunday (0) \342\200\246 Saturday (6). */\nconst WEEKLY_MENUS: Record<MealType, string[][]> = {\n  breakfast: [\n    [\'Dosa\', \'Sambar\', \'Coconut Chutney\', \'Boiled Egg\', \'Tea/Coffee\'],\n    [\'Idli\', \'Sambar\', \'Coconut Chutney\', \'Tea/Coffee\'],\n    [\'Pongal\', \'Medu Vada\', \'Sambar\', \'Tea/Coffee\'],\n    [\'Dosa\', \'Potato Masala\', \'Coconut Chutney\', \'Tea/Coffee\'],\n    [\'Upma\', \'Coconut Chutney\', \'Boiled Egg\', \'Tea/Coffee\'],\n    [\'Poori\', \'Potato Masala\', \'Banana\', \'Tea/Coffee\'],\n    [\'Idli\', \'Medu Vada\', \'Sambar\', \'Coconut Chutney\', \'Tea/Coffee\'],\n  ],\n  lunch: [\n    [\'Steamed Rice\', \'Sambar\', \'Chicken Curry\', \'Vegetable Curry\', \'Curd\'],\n    [\'Steamed Rice\', \'Sambar\', \'Vegetable Curry\', \'Curd\', \'Papad\'],\n    [\'Steamed Rice\', \'Dal Fry\', \'Chicken Curry\', \'Rasam\', \'Curd\'],\n    [\'Steamed Rice\', \'Sambar\', \'Vegetable Curry\', \'Rasam\', \'Payasam\'],\n    [\'Steamed Rice\', \'Dal Fry\', \'Chapati\', \'Vegetable Curry\', \'Curd\'],\n    [\'Veg Biryani\', \'Raita\', \'Rasam\', \'Papad\'],\n    [\'Chicken Biryani\', \'Raita\', \'Papad\', \'Payasam\'],\n  ],\n  dinner: [\n    [\'Chapati\', \'Paneer Butter Masala\', \'Fried Rice\', \'Veg Manchurian\'],\n    [\'Chapati\', \'Dal Tadka\', \'Paneer Butter Masala\', \'Curd Rice\'],\n    [\'Parotta\', \'Kurma\', \'Egg Curry\', \'Banana\'],\n    [\'Fried Rice\', \'Veg Manchurian\', \'Banana\'],\n    [\'Chapati\', \'Kurma\', \'Dal Tadka\', \'Curd Rice\'],\n    [\'Lemon Rice\', \'Dal Tadka\', \'Chapati\', \'Banana\'],\n    [\'Parotta\', \'Chicken Curry\', \'Kurma\', \'Banana\'],\n  ],\n};\n"
    num_lines: 265
