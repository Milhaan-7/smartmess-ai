93\",\n  \"measurementId\": \"\",\n  \"oAuthClientId\": \"948644310193-cr4frd6hjom1u8v9ta1m1l0bubhd2gu8.apps.googleusercontent.com\",\n  \"recaptchaSiteKey\": \"\"\n}\n```\n\n--- /index.html ---\n```html\n<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <meta name=\"description\" content=\"SmartMess AI \342\200\224 demand forecasting and food-waste reduction for institutional kitchens (demo with synthetic data).\" />\n    <meta property=\"og:title\" content=\"SmartMess AI\" />\n    <meta property=\"og:description\" content=\"SmartMess AI \342\200\224 demand forecasting and food-waste reduction for institutional kitchens (demo with synthetic data).\" />\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n    <link href=\"https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap\" rel=\"stylesheet\" />\n    <title>SmartMess AI</title>\n  </head>\n  <body>\n    <div id=\"root\"></div>\n    <script type=\"module\" src=\"/src/main.tsx\"></script>\n  </body>\n</html>\n\n```\n\n--- /metadata.json ---\n```json\n{\n  \"name\": \"SmartMess AI\",\n  \"description\": \"SmartMess AI \342\200\224 demand forecasting and food-waste reduction for institutional kitchens (demo with synthetic data).\",\n  \"permissions\": [],\n  \"capabilities\": []\n}\n\n```\n\n--- /src/App.tsx ---\n```typescript\nimport type { ComponentType } from \'react\';\nimport type { PageId } from \'./types\';\nimport { useRoute } from \'./lib/router\';\nimport { AppShell } from \'./components/layout/AppShell\';\nimport { AppStoreProvider } from \'./store/AppStore\';\nimport { ToastProvider } from \'./components/common/Toast\';\nimport Dashboard from \'./pages/Dashboard\';\nimport Forecasts from \'./pages/Forecasts\';\nimport Menus from \'./pages/Menus\';\nimport KitchenOperations from \'./pages/KitchenOperations\';\nimport WasteAnalytics from \'./pages/WasteAnalytics\';\nimport Settings from \'./pages/Settings\';\nimport Login from \'./pages/Login\';\n\nconst PAGES: Record<PageId, ComponentType> = {\n  dashboard: Dashboard,\n  forecasts: Forecasts,\n  menus: Menus,\n  operations: KitchenOperations,\n  waste: WasteAnalytics,\n  settings: Settings,\n  login: Login,\n};\n\nimport { useAppStore } from \'./store/AppStore\';\nimport { getNavItemsForRole } from \'./components/layout/Sidebar\';\n\nfunction Routes() {\n  const route = useRoute();\n  const { currentUser } = useAppStore();\n\n  if (!currentUser || route.page === \'login\') {\n    return <Login />;\n  }\n\n  const role = currentUser.role;\n  const allowedPages = getNavItemsForRole(role).map((item) => item.id);\n  \n  const isAllowed = allowedPages.includes(route.page);\n  const activePage = isAllowed ? route.page : \'dashboard\';\n  const Page = PAGES[activePage];\n\n  return (\n    <AppShell page={activePage}>\n      {/* Keyed by the full hash so a page re-reads its URL parameters when they change. */}\n      <Page key={route.raw} />\n    </AppShell>\n  );\n}\n\n\nexport default function App() {\n  return (\n    <AppStoreProvider>\n      <ToastProvider>\n        <Routes />\n      </ToastProvider>\n    </AppStoreProvider>\n  );\n}\n\n```\n\n--- /src/index.css ---\n```css\n@import \"tailwindcss\";\n\n@theme {\n  --font-sans: \"Plus Jakarta Sans\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n  --font-mono: \"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;\n\n  /* Forest green brand scale */\n  --color-brand-50: #f0f7f2;\n  --color-brand-100: #dcede2;\n  --color-brand-200: #bbdbc7;\n  --color-brand-300: #8dc0a1;\n  --color-brand-400: #5a9e77;\n  --color-brand-500: #3a8059;\n  --color-brand-600: #2a6847;\n  --color-brand-700: #1f583c;\n  --color-brand-800: #1a4731;\n  --color-brand-900: #143827;\n}\n\n@layer base {\n  /* Grid items default to min-width:auto, so a wide table inside a card would stretch the whole page.\n     Letting grid children shrink keeps tables scrolling inside their own card. */\n  main .grid > * {\n    min-width: 0;\n  }\n  html {\n    -webkit-font-smoothing: antialiased;\n    scroll-behavior: smooth;\n  }\n  body {\n    margin: 0;\n    background: #f8fafc;\n    color: #0f172a;\n    font-family: var(--font-sans);\n    font-size: 14px;\n    line-height: 1.5;\n  }\n  :focus-visible {\n    outline: 2px solid var(--color-brand-500);\n    outline-offset: 2px;\n  }\n  @media (prefers-reduced-motion: reduce) {\n    html { scroll-behavior: auto; }\n    * { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; }\n  }\n}\n\n.recharts-wrapper { font-size: 12px; }\n\n```\n\n--- /src/main.tsx ---\n```typescript\nimport { StrictMode } from \'react\';\nimport { createRoot } from \'react-dom/client\';\nimport App from \'./App\';\nimport \'./index.css\';\n\ncreateRoot(document.getElementById(\'root\')!).render(\n  <StrictMode>\n    <App />\n  </StrictMode>,\n);\n\n```\n\n--- /tsconfig.json ---\n```json\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"useDefineForClassFields\": true,\n    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"],\n    \"module\": \"ESNext\",\n    \"skipLibCheck\": true,\n    \"moduleResolution\": \"bundler\",\n    \"allowImportingTsExtensions\": true,\n    \"isolatedModules\": true,\n    \"moduleDetection\": \"force\",\n    \"noEmit\": true,\n    \"jsx\": \"react-jsx\",\n    \"strict\": true,\n    \"noUnusedLocals\": true,\n    \"noUnusedParameters\": true,\n    \"noFallthroughCasesInSwitch\": true,\n    \"types\": [\"vite/client\", \"vitest/globals\", \"@testing-library/jest-dom\"]\n  },\n  \"include\": [\"src\", \"vite.config.ts\", \"server.ts\"]\n}\n\n```\n\n--- /vite.config.ts ---\n```typescript\nimport { defineConfig } from \'vite\';\nimport react from \'@vitejs/plugin-react\';\nimport tailwindcss from \'@tailwindcss/vite\';\n\nexport default defineConfig({\n  plugins: [react(), tailwindcss()],\n  server: {\n    host: \'0.0.0.0\',\n    port: 3000,\n    strictPort: true,\n    allowedHosts: true,\n    cors: true,\n  },\n  build: {\n    chunkSizeWarningLimit: 700, // recharts (+ d3) is the bulk of the bundle\n    rollupOptions: {\n      output: { manualChunks: { charts: [\'recharts\'] } },\n    },\n  },\n  test: {\n    environment: \'jsdom\',\n    setupFiles: [\'./src/test/setup.ts\'],\n    globals: true,\n    css: false,\n  },\n} as any);\n\n```"
