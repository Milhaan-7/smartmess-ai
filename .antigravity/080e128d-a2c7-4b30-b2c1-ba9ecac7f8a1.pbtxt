        instruction: "import { useState } from \'react\';\nimport { ShieldCheck, ChefHat, GraduationCap, ArrowRight, Sparkles, Building2, Utensils, CheckCircle2, Lock, TrendingUp, BarChart3, Clock, Layers } from \'lucide-react\';\nimport { useAppStore, type UserRole } from \'../store/AppStore\';\nimport { hrefFor } from \'../lib/router\';\n\nexport default function Login() {\n  const { switchRole } = useAppStore();\n  const [loadingRole, setLoadingRole] = useState<UserRole | null>(null);\n\n  const handleSignIn = async (role: UserRole) => {\n    setLoadingRole(role);\n    try {\n      await switchRole(role);\n      window.location.hash = hrefFor(\'dashboard\');\n      if (typeof window !== \'undefined\') {\n        window.dispatchEvent(new HashChangeEvent(\'hashchange\'));\n      }\n    } catch (err) {\n      console.error(\'Failed demo sign in:\', err);\n    } finally {\n      setLoadingRole(null);\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen w-full flex flex-col lg:grid lg:grid-cols-12 bg-[#07111F] text-slate-100 selection:bg-brand-500 selection:text-white overflow-x-hidden\">\n      {/* LEFT SIDE \342\200\224 Split Screen Photo & Story (Approx 58% / lg:col-span-7) */}\n      <div className=\"relative lg:col-span-7 flex flex-col justify-between p-8 sm:p-12 lg:p-16 overflow-hidden min-h-[40vh] lg:min-h-screen\">\n        {/* Background Photo */}\n        <div \n          className=\"absolute inset-0 z-0 bg-cover bg-center filter brightness-90 scale-105 transform transition-transform duration-1000\"\n          style={{ backgroundImage: `url(\'https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=1600&q=80\')` }}\n        />\n        {/* Dark Navy Gradient Overlay */}\n        <div className=\"absolute inset-0 z-10 bg-gradient-to-t from-[#07111F] via-[#07111F]/80 to-[#07111F]/50 backdrop-blur-[2px]\" />\n        \n        {/* Decorative Glows */}\n        <div className=\"absolute -top-32 -left-32 h-96 w-96 rounded-full bg-brand-500/20 blur-[100px] z-10 pointer-events-none\" />\n        <div className=\"absolute bottom-1/4 -right-32 h-96 w-96 rounded-full bg-emerald-500/20 blur-[100px] z-10 pointer-events-none\" />\n\n        {/* Top Header Logo */}\n        <div className=\"relative z-20 flex items-center justify-between\">\n          <div className=\"flex items-center gap-3\">\n            <span className=\"flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br from-brand-500 to-emerald-700 text-white font-extrabold text-xl shadow-2xl shadow-brand-600/40 ring-2 ring-white/20\">\n              S\n            </span>\n            <div>\n              <div className=\"text-xl font-extrabold tracking-tight text-white flex items-center gap-2\">\n                SmartMess <span className=\"text-emerald-400\">AI</span>\n                <span className=\"inline-flex items-center gap-1 rounded-full bg-emerald-500/20 px-2.5 py-0.5 text-[11px] font-semibold text-emerald-300 ring-1 ring-emerald-500/30\">\n                  <Sparkles size={10} /> AI-Powered\n                </span>\n              </div>\n              <p className=\"text-xs font-medium text-slate-300\">AI-powered institutional dining intelligence</p>\n            </div>\n          </div>\n\n          <div className=\"hidden sm:flex items-center gap-2 text-xs font-medium text-slate-200 bg-slate-900/80 px-3.5 py-1.5 rounded-full border border-slate-700/80 backdrop-blur\">\n            <Building2 size={13} className=\"text-emerald-400\" />\n            <span>St. Jude Campus Dining Hall #4</span>\n          </div>\n        </div>\n\n        {/* Center Story & Highlights */}\n        <div className=\"relative z-20 my-auto py-12 max-w-2xl\">\n          <div className=\"inline-flex items-center gap-2 rounded-full bg-emerald-500/10 px-3 py-1 text-xs font-semibold text-emerald-300 border border-emerald-500/30 mb-6\">\n            <Lock size={12} className=\"text-emerald-400\" /> Demo Access \302\267 Synthetic Data Active\n          </div>\n          \n          <h1 className=\"text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.1] mb-6\">\n            Smarter Kitchens. <br />\n            <span className=\"text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-brand-400 to-cyan-300\">\n              Happier Campuses.\n            </span>\n          </h1>\n\n          <p className=\"text-base sm:text-lg text-slate-300 leading-relaxed mb-10 max-w-xl\">\n            Eliminate over-preparation and reduce organic dining hall waste with transparent deterministic forecasting, automated kitchen preparation targets, and real-time approval workflows.\n          </p>\n\n          {/* Three Compact Feature Highlights */}\n          <div className=\"space-y-4\">\n            <div className=\"flex items-center gap-4 rounded-xl bg-slate-900/60 border border-slate-800/80 p-4 backdrop-blur transition-all hover:border-emerald-500/40\">\n              <div className=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-500/20 text-brand-400 ring-1 ring-brand-500/30\">\n                <TrendingUp size={20} />\n              </div>\n              <div>\n                <h3 className=\"text-sm font-bold text-white\">AI Demand Forecasting</h3>\n                <p className=\"text-xs text-slate-300\">Time-aware trend analysis, holiday factors, and menu impact models.</p>\n              </div>\n            </div>\n\n            <div className=\"flex items-center gap-4 rounded-xl bg-slate-900/60 border border-slate-800/80 p-4 backdrop-blur transition-all hover:border-emerald-500/40\">\n              <div className=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-emerald-500/20 text-emerald-400 ring-1 ring-emerald-500/30\">\n                <Sparkles size={20} />\n              </div>\n              <div>\n                <h3 className=\"text-sm font-bold text-white\">Reduce Food Waste</h3>\n                <p className=\"text-xs text-slate-300\">Track MAE, WAPE, leftover ratios, and residual organic waste metrics.</p>\n              </div>\n            </div>\n\n            <div className=\"flex items-center gap-4 rounded-xl bg-slate-900/60 border border-slate-800/80 p-4 backdrop-blur transition-all hover:border-emerald-500/40\">\n              <div className=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-cyan-500/20 text-cyan-400 ring-1 ring-cyan-500/30\">\n                <Layers size={20} />\n              </div>\n              <div>\n                <h3 className=\"text-sm font-bold text-white\">Better Dining Experience</h3>\n                <p className=\"text-xs text-slate-300\">Published daily menus, accurate meal timings, and instant notifications.</p>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Bottom Footer Credits */}\n        <div className=\"relative z-20 flex flex-wrap items-center justify-between gap-4 text-xs text-slate-400 pt-6 border-t border-slate-800/60\">\n          <span>SmartMess AI \342\200\224 Institutional Dining Intelligence</span>\n          <span className=\"flex items-center gap-1.5\">\n            <span className=\"h-2 w-2 rounded-full bg-emerald-400 animate-pulse\" />\n            System Operational\n          </span>\n        </div>\n      </div>\n\n      {/* RIGHT SIDE \342\200\224 Sign-In & Role Selection Panel (Approx 42% / lg:col-span-5) */}\n      <div className=\"relative lg:col-span-5 flex flex-col justify-center px-6 sm:px-10 lg:px-12 py-12 bg-[#07111F] lg:bg-[#07111F]/95 border-t lg:border-t-0 lg:border-l border-slate-800 shadow-2xl z-20\">\n        <div className=\"max-w-md w-full mx-auto\">\n          <div className=\"mb-8 text-left\">\n            <div className=\"inline-flex items-center gap-2 rounded-full bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-300 border border-brand-500/25 mb-3\">\n              Role-Based Access\n            </div>\n            <h2 className=\"text-2xl sm:text-3xl font-extrabold tracking-tight text-white mb-2\">\n              Welcome to SmartMess AI\n            </h2>\n            <p className=\"text-xs sm:text-sm text-slate-300\">\n              Select your dining hall persona to explore the live demo and workflows.\n            </p>\n          </div>\n\n          {/* Three Compact Demo Role Options */}\n          <div className=\"space-y-4\">\n            {/* 1. Mess Manager */}\n            <div className=\"group relative flex flex-col justify-between rounded-2xl border border-slate-800 bg-slate-900/90 p-5 backdrop-blur transition-all duration-300 hover:border-brand-500/60 hover:bg-slate-900 hover:shadow-xl hover:shadow-brand-950/40\">\n              <div>\n                <div className=\"flex items-center justify-between mb-3\">\n                  <div className=\"flex items-center gap-3\">\n                    <span className=\"flex h-10 w-10 items-center justify-center rounded-xl bg-brand-500/15 text-brand-400 ring-1 ring-brand-500/30 group-hover:scale-105 transition-transform\">\n                      <ShieldCheck size={20} />\n                    </span>\n                    <div>\n                      <h3 className=\"text-base font-bold text-white\">Mess Manager</h3>\n                      <p className=\"text-[11px] text-brand-400 font-medium\">Full Administrative Control</p>\n                    </div>\n                  </div>\n                </div>\n                <p className=\"text-xs text-slate-300 mb-4 leading-relaxed\">\n                  Complete authority over demand forecasting, menu planning, prep plan approvals, and waste analytics.\n                </p>\n                <ul className=\"space-y-1.5 mb-5 text-[11px] text-slate-300\">\n                  <li className=\"flex items-center gap-2\">\n                    <CheckCircle2 size={13} className=\"text-brand-400 shrink-0\" />\n                    <span>Review & approve daily preparation plans</span>\n                  </li>\n                  <li className=\"flex items-center gap-2\">\n                    <CheckCircle2 size={13} className=\"text-brand-400 shrink-0\" />\n                    <span>Inspect WAPE & MAE waste analytics</span>\n                  </li>\n                  <li className=\"flex items-center gap-2\">\n                    <CheckCircle2 size={13} className=\"text-brand-400 shrink-0\" />\n                    <span>Access AI Assistant operational chat</span>\n                  </li>\n                </ul>\n              </div>\n              <button\n                type=\"button\"\n                onClick={() => handleSignIn(\'manager\')}\n                disabled={loadingRole !== null}\n                className=\"w-full flex items-center justify-center gap-2 rounded-xl bg-brand-600 px-4 py-2.5 text-xs font-bold text-white shadow-lg shadow-brand-600/30 hover:bg-brand-500 active:bg-brand-700 disabled:opacity-50 transition-all\"\n              >\n                {loadingRole === \'manager\' ? (\n                  <span>Signing in...</span>\n                ) : (\n                  <>\n                    <span>Sign In as Manager</span>\n                    <ArrowRight size={13} />\n                  </>\n                )}\n              </button>\n            </div>\n\n            {/* 2. Kitchen Staff */}\n            <div className=\"group relative flex flex-col justify-between rounded-2xl border border-slate-800 bg-slate-900/90 p-5 backdrop-blur transition-all duration-300 hover:border-amber-500/60 hover:bg-slate-900 hover:shadow-xl hover:shadow-amber-950/40\">\n              <div>\n                <div className=\"flex items-center justify-between mb-3\">\n                  <div className=\"flex items-center gap-3\">\n                    <span className=\"flex h-10 w-10 items-center justify-center rounded-xl bg-amber-500/15 text-amber-400 ring-1 ring-amber-500/30 group-hover:scale-105 transition-transform\">\n                      <ChefHat size={20} />\n                    </span>\n                    <div>\n                      <h3 className=\"text-base font-bold text-white\">Kitchen Staff</h3>\n                      <p className=\"text-[11px] text-amber-400 font-medium\">Culinary Line Operations</p>\n                    </div>\n                  </div>\n                </div>\n                <p className=\"text-xs text-slate-300 mb-4 leading-relaxed\">\n                  Executes manager-approved batch prep targets on the line and logs actual servings and residual leftovers.\n                </p>\n                <ul className=\"space-y-1.5 mb-5 text-[11px] text-slate-300\">\n                  <li className=\"flex items-center gap-2\">\n                    <CheckCircle2 size={13} className=\"text-amber-400 shrink-0\" />\n                    <span>View authorized batch preparation targets</span>\n                  </li>\n                  <li className=\"flex items-center gap-2\">\n                    <CheckCircle2 size={13} className=\"text-amber-400 shrink-0\" />\n                    <span>Log actual prepared & consumed quantities</span>\n                  </li>\n                  <li className=\"flex items-center gap-2\">\n                    <CheckCircle2 size={13} className=\"text-amber-400 shrink-0\" />\n                    <span>Record end-of-service residual waste logs</span>\n                  </li>\n                </ul>\n              </div>\n              <button\n                type=\"button\"\n                onClick={() => handleSignIn(\'kitchen_staff\')}\n                disabled={loadingRole !== null}\n                className=\"w-full flex items-center justify-center gap-2 rounded-xl bg-amber-600 px-4 py-2.5 text-xs font-bold text-white shadow-lg shadow-amber-600/30 hover:bg-amber-500 active:bg-amber-700 disabled:opacity-50 transition-all\"\n              >\n                {loadingRole === \'kitchen_staff\' ? (\n                  <span>Signing in...</span>\n                ) : (\n                  <>\n                    <span>Sign In as Kitchen Staff</span>\n                    <ArrowRight size={13} />\n                  </>\n                )}\n              </button>\n            </div>\n\n            {/* 3. Student / Diner */}\n            <div className=\"group relative flex flex-col justify-between rounded-2xl border border-slate-800 bg-slate-900/90 p-5 backdrop-blur transition-all duration-300 hover:border-emerald-500/60 hover:bg-slate-900 hover:shadow-xl hover:shadow-emerald-950/40\">\n              <div>\n                <div className=\"flex items-center justify-between mb-3\">\n                  <div className=\"flex items-center gap-3\">\n                    <span className=\"flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-500/15 text-emerald-400 ring-1 ring-emerald-500/30 group-hover:scale-105 transition-transform\">\n                      <GraduationCap size={20} />\n                    </span>\n                    <div>\n                      <h3 className=\"text-base font-bold text-white\">Student / Diner</h3>\n                      <p className=\"text-[11px] text-emerald-400 font-medium\">Campus Diner Visibility</p>\n                    </div>\n                  </div>\n                </div>\n                <p className=\"text-xs text-slate-300 mb-4 leading-relaxed\">\n                  Browses published daily menus, portion sizes, service hours, and receives instant approval notification alerts.\n                </p>\n                <ul className=\"space-y-1.5 mb-5 text-[11px] text-slate-300\">\n                  <li className=\"flex items-center gap-2\">\n                    <CheckCircle2 size={13} className=\"text-emerald-400 shrink-0\" />\n                    <span>View today\'s published breakfast, lunch & dinner</span>\n                  </li>\n                  <li className=\"flex items-center gap-2\">\n                    <CheckCircle2 size={13} className=\"text-emerald-400 shrink-0\" />\n                    <span>Receive menu approval notification alerts</span>\n                  </li>\n                  <li className=\"flex items-center gap-2\">\n                    <CheckCircle2 size={13} className=\"text-emerald-400 shrink-0\" />\n                    <span>View published menus, meal timings, and notifications</span>\n                  </li>\n                </ul>\n              </div>\n              <button\n                type=\"button\"\n                onClick={() => handleSignIn(\'student\')}\n                disabled={loadingRole !== null}\n                className=\"w-full flex items-center justify-center gap-2 rounded-xl bg-emerald-600 px-4 py-2.5 text-xs font-bold text-white shadow-lg shadow-emerald-600/30 hover:bg-emerald-500 active:bg-emerald-700 disabled:opacity-50 transition-all\"\n              >\n                {loadingRole === \'student\' ? (\n                  <span>Signing in...</span>\n                ) : (\n                  <>\n                    <span>Sign In as Student</span>\n                    <ArrowRight size={13} />\n                  </>\n                )}\n              </button>\n            </div>\n          </div>\n\n          <div className=\"mt-8 pt-6 border-t border-slate-800 text-center\">\n            <p className=\"text-[11px] text-slate-400\">\n              Demo access \302\267 Synthetic data \302\267 Browser LocalStorage persistence active.\n            </p>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/pages/Login.tsx"
        }
        overwrite: true
      }
    }
