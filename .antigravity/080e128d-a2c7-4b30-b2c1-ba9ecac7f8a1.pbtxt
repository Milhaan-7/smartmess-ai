  view_file {
    absolute_path_uri: "file:///src/db/users.ts"
    end_line: 97
    content: "import { db, isConfigError } from \'./index.ts\';\nimport { users } from \'./schema.ts\';\nimport { eq } from \'drizzle-orm\';\n\nexport type UserRole = \'manager\' | \'kitchen_staff\' | \'student\';\n\nexport async function getUserByUid(uid: string) {\n  try {\n    const rows = await db.select().from(users).where(eq(users.uid, uid));\n    return rows[0] || null;\n  } catch (error) {\n    if (isConfigError(error)) {\n      console.warn(\'[Users] Database unconfigured: skipping user lookup for\', uid);\n    } else {\n      console.error(\'Error fetching user by uid:\', error);\n    }\n    throw new Error(\'Database query failed. Please try again later.\', { cause: error });\n  }\n}\n\nexport async function getOrCreateUser(\n  uid: string,\n  email: string,\n  displayName?: string,\n  defaultRole: UserRole = \'student\',\n) {\n  try {\n    const existing = await getUserByUid(uid);\n    if (existing) {\n      if (displayName && existing.displayName !== displayName) {\n        await db\n          .update(users)\n          .set({ displayName, updatedAt: new Date() })\n          .where(eq(users.uid, uid));\n        return { ...existing, displayName };\n      }\n      return existing;\n    }\n\n    const isManagerDefault =\n      email === \'mahmoodmilhaan777@gmail.com\' ||\n      email.toLowerCase().includes(\'manager\') ||\n      defaultRole === \'manager\';\n\n    const assignedRole: UserRole = isManagerDefault ? \'manager\' : defaultRole;\n\n    const [created] = await db\n      .insert(users)\n      .values({\n        uid,\n        email,\n        displayName: displayName || email.split(\'@\')[0],\n        role: assignedRole,\n      })\n      .returning();\n\n    return created;\n  } catch (error) {\n    if (isConfigError(error)) {\n      console.warn(\'[Users] Database unconfigured in getOrCreateUser\');\n    } else {\n      console.error(\'Error in getOrCreateUser:\', error);\n    }\n    throw new Error(\'Database user sync failed.\', { cause: error });\n  }\n}\n\nexport async function updateUserRole(uid: string, newRole: UserRole) {\n  try {\n    const [updated] = await db\n      .update(users)\n      .set({ role: newRole, updatedAt: new Date() })\n      .where(eq(users.uid, uid))\n      .returning();\n    return updated;\n  } catch (error) {\n    if (isConfigError(error)) {\n      console.warn(\'[Users] Database unconfigured in updateUserRole\');\n    } else {\n      console.error(\'Error updating user role:\', error);\n    }\n    throw new Error(\'Failed to update user role.\', { cause: error });\n  }\n}\n\nexport async function getUsers() {\n  try {\n    return await db.select().from(users);\n  } catch (error) {\n    if (isConfigError(error)) {\n      console.warn(\'[Users] Database unconfigured in getUsers\');\n    } else {\n      console.error(\'Database query failed:\', error);\n    }\n    throw new Error(\'Database query failed. Please try again later.\', { cause: error });\n  }\n}\n"
    num_lines: 98
    num_bytes: 2799
    line_range_bytes: 2799
  }
}
